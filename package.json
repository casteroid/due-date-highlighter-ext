{
  "name": "due-date-highlighter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "icons": "node scripts/icons.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "fixture": "node scripts/serve-fixture.mjs",
    "package": "npm run build && mkdir -p release && rm -f release/*.zip && cd dist && zip -qrX ../release/due-date-highlighter-$npm_package_version.zip .",
    "release:plan": "node scripts/release/plan.ts",
    "lint:commits": "node scripts/release/lint-commits.ts",
    "site": "node scripts/site.mjs"
  },
  "dependencies": {
    "chrono-node": "^2.10.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
