{
  "manifest_version": 3,
  "name": "Due Date Highlighter",
  "version": "0.1.0",
  "description": "Highlights dates on the pages you choose, coloured by how close they are.",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Due Date Highlighter" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
